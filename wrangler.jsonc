{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "billowing-forest-66bc",
  "compatibility_date": "2026-08-04",
  "main": "worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "keep_vars": true
}
