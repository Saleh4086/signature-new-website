{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "billowing-forest-66bc",
  "compatibility_date": "2026-08-04",
  "main": "worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "kv_namespaces": [
    { "binding": "LISTINGS", "id": "1ecc1af7d0084b9588187b77e602fb94" }
  ],
  // Production plain vars only. keep_vars false drops plain vars that are not listed here,
  // so a main deploy cannot inherit preview-only vars. Do not add BROKERAGE_OS_BASE_URL.
  // Secrets are not affected by keep_vars.
  "vars": {
    "BROKERAGE_OS_WEBSITE_LEADS_ENABLED": "true",
    "IDX_ENABLED": "true",
    "IDX_SEARCH_URL": "https://blackstonesignatureproperty.idxbroker.com/idx/search/advanced"
  },
  "preview_urls": true,
  "keep_vars": false
}
